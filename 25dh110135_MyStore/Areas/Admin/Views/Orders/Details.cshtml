@model _25dh110135_MyStore.Models.Order
@using _25dh110135_MyStore.Models

@{
    ViewBag.Title = "Details";
}

<h2 class="bg-success">CHI TIẾT ĐƠN HÀNG</h2>

<div>
    <hr />
    <dl class="dl-horizontal">
        <dt> Khách hàng </dt>
        <dd> @Html.DisplayFor(model => model.Customer.CustomerName) </dd>

        <dt> Ngày đặt hàng </dt>
        <dd> @Html.DisplayFor(model => model.OrderDate) </dd>

        <dt> Trạng thái thanh toán </dt>
        <dd> @Html.DisplayFor(model => model.PaymentStatus) </dd>

        <dt> Địa chỉ giao hàng </dt>
        <dd> @Html.DisplayFor(model => model.AddressDelivery) </dd>
    </dl>
</div>
<p>
    @Html.ActionLink("Sửa", "Edit", new { id = Model.OrderID }, new { @class = "btn btn-primary" }) |
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
</p>