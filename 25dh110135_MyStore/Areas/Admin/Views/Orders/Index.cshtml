@model IEnumerable<_25dh110135_MyStore.Models.Order>
@using _25dh110135_MyStore.Models

@{
    ViewBag.Title = "Index";
}

<h2 class="bg-success">DANH SÁCH ĐƠN HÀNG</h2>

<table class="table bg-info container-fluid">
    <tr>
        <th class="bg-success col-md-2"> Khách hàng </th>
        <th class="bg-success col-md-2"> Ngày đặt hàng </th>
        <th class="bg-success col-md-2"> Trạng thái thanh toán </th>
        <th class="bg-success col-md-2"> Địa chỉ giao hàng </th>
        <th class="bg-success col-md-4"></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Customer.CustomerName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PaymentStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AddressDelivery)
            </td>
            <td>
                @Html.ActionLink("Sửa", "Edit", new { id = item.OrderID }, new { @class = "btn btn-primary btn-sm" }) |
                @Html.ActionLink("Chi tiết", "Details", new { id = item.OrderID }, new { @class = "btn btn-primary btn-sm" }) |
                @Html.ActionLink("Xóa", "Delete", new { id = item.OrderID }, new { @class = "btn btn-primary btn-sm" })
            </td>
        </tr>
    }
</table>

<div class="form-group">
    <div class="col-md-offset-8 col-md-4">
        @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
    </div>
</div>