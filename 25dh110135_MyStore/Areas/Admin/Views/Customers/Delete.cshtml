@model _25dh110135_MyStore.Models.Customer
@using _25dh110135_MyStore.Models

@{
    ViewBag.Title = "Delete";
}

<h2 class="bg-success">XÓA KHÁCH HÀNG</h2>

<h3>Bạn có chắc chắn muốn xóa khách hàng này không?</h3>
<div>
    <hr />
    <dl class="dl-horizontal">
        <dt> Họ tên </dt>
        <dd> @Html.DisplayFor(model => model.CustomerName) </dd>

        <dt> Số điện thoại </dt>
        <dd> @Html.DisplayFor(model => model.CustomerPhone) </dd>

        <dt> Email </dt>
        <dd> @Html.DisplayFor(model => model.CustomerEmail) </dd>

        <dt> Địa chỉ </dt>
        <dd> @Html.DisplayFor(model => model.CustomerAddress) </dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Xóa" class="btn btn-danger" /> |
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
        </div>
    }
    }
