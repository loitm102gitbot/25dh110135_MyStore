@model _25dh110135_MyStore.Models.Product
@using _25dh110135_MyStore.Models

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XÓA SẢN PHẨM</h2>

<h3>Bạn có chắc chắn muốn xóa sản phẩm này không?</h3>
<div>
    <hr />
    <dl class="dl-horizontal">
        <dt> Danh mục </dt>
        <dd> @Html.DisplayFor(model => model.Category.CategoryName) </dd>

        <dt> Tên sản phẩm </dt>
        <dd> @Html.DisplayFor(model => model.ProductName) </dd>

        <dt> Đơn giá </dt>
        <dd> @Html.DisplayFor(model => model.ProductPrice) </dd>

        <dt> Hình ảnh </dt>
        <dd>
            <img src="@Url.Content(Model.ProductImage)" height="150" />
        </dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Xóa" class="btn btn-danger" /> |
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
        </div>
    }
    }
