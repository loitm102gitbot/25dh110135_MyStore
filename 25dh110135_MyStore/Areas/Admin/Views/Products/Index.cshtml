@model IEnumerable<_25dh110135_MyStore.Models.Product>
@using _25dh110135_MyStore.Models

@{
    ViewBag.Title = "Index";
}

<head>
    <style>
        img {
            height: 150px;
            max-width: 150px;
        }
    </style>
</head>

<!-- Thanh tìm kiếm nằm ở phía trên tiêu đề giống hệt slide mẫu -->
@using (Html.BeginForm("Index", "Products", FormMethod.Get))
{
    <div class="form-group row mb-3" style="margin-bottom: 15px;">
        <div class="col-md-4" style="display: inline-block; width: 32%;">
            @Html.TextBox("searchString", ViewBag.CurrentFilter as string, new { @class = "form-control", @placeholder = "Nhập tên, mô tả hoặc chủng loại sản phẩm" })
        </div>
        <div class="col-md-2" style="display: inline-block; width: 20%;">
            @Html.TextBox("minPrice", ViewBag.MinPrice as string, new { @class = "form-control", @placeholder = "Nhập giá tối thiểu" })
        </div>
        <div class="col-md-2" style="display: inline-block; width: 20%;">
            @Html.TextBox("maxPrice", ViewBag.MaxPrice as string, new { @class = "form-control", @placeholder = "Nhập giá tối đa" })
        </div>
        <div class="col-md-2" style="display: inline-block;">
            <input type="submit" value="Tìm kiếm" class="btn btn-primary" />
        </div>
    </div>
}

<h2 class="bg-success">DANH SÁCH SẢN PHẨM</h2>

<table class="table bg-info container-fluid">
    <tr>
        <th class="bg-success col-md-2"> Hình ảnh </th>
        <th class="bg-success col-md-3"> Tên sản phẩm </th>
        <th class="bg-success col-md-1"> Đơn giá </th>
        <th class="bg-success col-md-2"> Danh mục </th>
        <th class="bg-success col-md-4"></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
            <td>
                <img src="~/images/@item.ProductImage" width="70" height="90" style="object-fit: cover;" />
            </td>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.CategoryName)
            </td>
            <td>
                @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" }) |
                @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" }) |
                @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" })
            </td>
        </tr>
    }
</table>

<div class="form-group">
    <div class="col-md-offset-8 col-md-4">
        @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
    </div>
</div>